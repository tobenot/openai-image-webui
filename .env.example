# Optional build-time defaults for the settings panel.
#
# These only prefill the UI — users can still change them at runtime. Values are
# baked into the public bundle: NEVER put an API key here, because Vite inlines
# every VITE_* variable into the shipped JavaScript.

VITE_DEFAULT_MODEL=gpt-image-1
VITE_DEFAULT_VISION_MODEL=gpt-4.1-mini

# Declared in the original design doc but not read by the app today.
# VITE_APP_NAME=OpenAI Image WebUI
